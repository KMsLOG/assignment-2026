# MySQL 초기 계정 정보
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=course_registration
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app-password

# 애플리케이션 런타임 옵션
APP_DEBUG=false
LOG_LEVEL=INFO
# 쉼표로 구분된 허용 출처 목록 (예: "http://localhost:8000,http://localhost:3000")
CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:3000

# DB 커넥션 풀 튜닝 (급증 트래픽 대응)
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800

# 수강신청 API 백프레셔(동시 처리 상한)
ENROLLMENT_MAX_INFLIGHT_REQUESTS=40
# 수강신청 트랜잭션 락 충돌(1205/1213) 재시도 설정
ENROLLMENT_LOCK_RETRY_ATTEMPTS=3
ENROLLMENT_LOCK_RETRY_BACKOFF_SECONDS=0.05
